@using LegoTracker.Data
@using LegoTracker.Data.Entities
@using LegoTracker.Data.Enums
@using Microsoft.EntityFrameworkCore
@inject LegoTrackerDbContext Db

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
    <MudText Typo="Typo.h6">Missing / Damaged Parts</MudText>
    <MudStack Row="true" Spacing="2">
        <MudButton Href="@($"/api/sets/{LegoSetId}/missing-parts/export?format=csv")" Variant="Variant.Outlined" Size="Size.Small">
            Export CSV
        </MudButton>
        <MudButton Href="@($"/api/sets/{LegoSetId}/missing-parts/export?format=wanted")" Variant="Variant.Outlined" Size="Size.Small">
            Export Wanted List
        </MudButton>
    </MudStack>
</MudStack>

<MudPaper Class="pa-4 mb-4" Outlined="true">
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Start" Wrap="Wrap.Wrap">
        <MudTextField @bind-Value="_newPartNum" Label="Part # (optional)" />
        <MudSelect T="int?" @bind-Value="_newColorId" Label="Color (optional)">
            <MudSelectItem T="int?" Value="null">—</MudSelectItem>
            @foreach (var color in _colors)
            {
                <MudSelectItem T="int?" Value="color.Id">@color.Name</MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="IssueType" @bind-Value="_newIssueType" Label="Type">
            @foreach (var issueType in Enum.GetValues<IssueType>())
            {
                <MudSelectItem T="IssueType" Value="issueType">@issueType</MudSelectItem>
            }
        </MudSelect>
        <MudNumericField T="int" @bind-Value="_newQuantity" Label="Quantity" Min="1" />
        <MudTextField @bind-Value="_newNotes" Label="Notes" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddMissingPart">Add</MudButton>
    </MudStack>
</MudPaper>

<MudDataGrid Items="_missingParts" Filterable="true" SortMode="SortMode.Multiple">
    <Columns>
        <PropertyColumn Property="x => x.PartNum" Title="Part #" />
        <PropertyColumn Property="x => x.Part!.Name" Title="Name" Sortable="false" />
        <PropertyColumn Property="x => x.Color!.Name" Title="Color" />
        <PropertyColumn Property="x => x.IssueType" />
        <PropertyColumn Property="x => x.Quantity" />
        <PropertyColumn Property="x => x.Notes" />
        <TemplateColumn Title="Status" Sortable="false" Filterable="false">
            <CellTemplate>
                @if (context.Item.ResolvedAtUtc is null)
                {
                    <MudButton Size="Size.Small" OnClick="@(() => Resolve(context.Item))">Mark Resolved</MudButton>
                }
                else
                {
                    <MudChip T="string" Color="Color.Success" Size="Size.Small">Resolved</MudChip>
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Sortable="false" Filterable="false">
            <CellTemplate>
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" OnClick="@(() => Delete(context.Item))" />
            </CellTemplate>
        </TemplateColumn>
    </Columns>
</MudDataGrid>

@code {
    [Parameter, EditorRequired] public int LegoSetId { get; set; }

    private List<MissingPart> _missingParts = [];
    private List<LegoColor> _colors = [];

    private string _newPartNum = "";
    private int? _newColorId;
    private IssueType _newIssueType = IssueType.Missing;
    private int _newQuantity = 1;
    private string _newNotes = "";

    protected override async Task OnInitializedAsync()
    {
        _colors = await Db.Colors.OrderBy(c => c.Name).ToListAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _missingParts = await Db.MissingParts
            .Include(m => m.Part)
            .Include(m => m.Color)
            .Where(m => m.LegoSetId == LegoSetId)
            .OrderBy(m => m.ResolvedAtUtc.HasValue).ThenByDescending(m => m.CreatedAtUtc)
            .ToListAsync();
    }

    private async Task AddMissingPart()
    {
        Db.MissingParts.Add(new MissingPart
        {
            LegoSetId = LegoSetId,
            PartNum = string.IsNullOrWhiteSpace(_newPartNum) ? null : _newPartNum.Trim(),
            ColorId = _newColorId,
            IssueType = _newIssueType,
            Quantity = _newQuantity,
            Notes = string.IsNullOrWhiteSpace(_newNotes) ? null : _newNotes.Trim()
        });
        await Db.SaveChangesAsync();

        _newPartNum = "";
        _newColorId = null;
        _newIssueType = IssueType.Missing;
        _newQuantity = 1;
        _newNotes = "";
        await LoadAsync();
    }

    private async Task Resolve(MissingPart missingPart)
    {
        missingPart.ResolvedAtUtc = DateTime.UtcNow;
        await Db.SaveChangesAsync();
        await LoadAsync();
    }

    private async Task Delete(MissingPart missingPart)
    {
        Db.MissingParts.Remove(missingPart);
        await Db.SaveChangesAsync();
        await LoadAsync();
    }
}
