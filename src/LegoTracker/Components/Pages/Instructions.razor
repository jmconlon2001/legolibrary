@page "/sets/{Id:int}/instructions"
@using LegoTracker.Data
@using LegoTracker.Data.Entities
@using LegoTracker.Data.Enums
@using LegoTracker.Services.Media
@using LegoTracker.Services.Notifications
@using Microsoft.EntityFrameworkCore
@implements IDisposable
@inject LegoTrackerDbContext Db
@inject MediaDownloadQueue DownloadQueue
@inject INotificationService Notifications

<PageTitle>Instructions — @(_set?.Name)</PageTitle>

@if (_set is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudText Typo="Typo.h4" Class="mb-4">Instructions — @_set.Name (@_set.SetNum)</MudText>

    <MudPaper Class="pa-4 mb-4" Outlined="true">
        <MudText Typo="Typo.h6" Class="mb-2">Add manual</MudText>
        <MudText Typo="Typo.caption" Class="mb-2">
            Rebrickable doesn't provide instruction PDF links — paste a URL you've found
            (e.g. from LEGO's customer service site) and it will be downloaded and cached locally.
        </MudText>
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Start">
            <MudTextField @bind-Value="_newSourceUrl" Label="PDF URL" Class="flex-grow-1" Disabled="_isAdding" />
            <MudTextField @bind-Value="_newLabel" Label="Label (optional)" Placeholder="Book 1 of 3" Disabled="_isAdding" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddManual"
                       Disabled="@(_isAdding || string.IsNullOrWhiteSpace(_newSourceUrl))">
                Add
            </MudButton>
        </MudStack>
    </MudPaper>

    @foreach (var manual in _set.InstructionManuals.OrderBy(m => m.CreatedAtUtc))
    {
        <MudPaper Class="pa-4 mb-4" Outlined="true">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.subtitle1">@(manual.Label ?? manual.SourceUrl)</MudText>
                <MudChip T="string" Color="@StatusColor(manual.DownloadStatus)">@manual.DownloadStatus</MudChip>
            </MudStack>

            @switch (manual.DownloadStatus)
            {
                case DownloadStatus.Pending:
                case DownloadStatus.Downloading:
                    <MudProgressLinear Indeterminate="true" Class="mt-2" />
                    break;
                case DownloadStatus.Failed:
                    <MudAlert Severity="Severity.Error" Class="mt-2">@manual.ErrorMessage</MudAlert>
                    break;
                case DownloadStatus.Completed:
                    <iframe src="@($"/media/{manual.LocalFilePath}")" style="width:100%; height:800px; border:none;" class="mt-2"></iframe>
                    break;
            }
        </MudPaper>
    }
}

@code {
    [Parameter] public int Id { get; set; }

    private LegoSet? _set;
    private string _newSourceUrl = "";
    private string _newLabel = "";
    private bool _isAdding;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        Notifications.OnMediaDownloadChanged += HandleDownloadChanged;
    }

    private async Task LoadAsync()
    {
        _set = await Db.Sets
            .Include(s => s.InstructionManuals)
            .FirstOrDefaultAsync(s => s.Id == Id);
    }

    private async Task AddManual()
    {
        if (_set is null)
        {
            return;
        }

        _isAdding = true;
        var manual = new SetInstructionManual
        {
            LegoSetId = _set.Id,
            SourceUrl = _newSourceUrl.Trim(),
            Label = string.IsNullOrWhiteSpace(_newLabel) ? null : _newLabel.Trim()
        };
        Db.InstructionManuals.Add(manual);
        await Db.SaveChangesAsync();

        var relativePath = $"instructions/{_set.SetNum}/{manual.Id}.pdf";
        await DownloadQueue.EnqueueAsync(new MediaDownloadRequest(manual.Id, _set.Id, manual.SourceUrl, relativePath));

        _newSourceUrl = "";
        _newLabel = "";
        _isAdding = false;
        await LoadAsync();
    }

    private void HandleDownloadChanged(MediaDownloadEvent e)
    {
        if (e.LegoSetId != Id)
        {
            return;
        }

        InvokeAsync(async () =>
        {
            await LoadAsync();
            StateHasChanged();
        });
    }

    private static Color StatusColor(DownloadStatus status) => status switch
    {
        DownloadStatus.Completed => Color.Success,
        DownloadStatus.Failed => Color.Error,
        DownloadStatus.Downloading => Color.Info,
        _ => Color.Default
    };

    public void Dispose() => Notifications.OnMediaDownloadChanged -= HandleDownloadChanged;
}
