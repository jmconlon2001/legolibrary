@page "/storage-locations"
@using LegoTracker.Data
@using LegoTracker.Data.Entities
@using LegoTracker.Components.Shared
@using Microsoft.EntityFrameworkCore
@inject LegoTrackerDbContext Db

<PageTitle>Storage Locations</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Storage Locations</MudText>

<MudPaper Class="pa-4 mb-4" Outlined="true">
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Start" Wrap="Wrap.Wrap">
        <MudTextField @bind-Value="_newName" Label="Name" Placeholder="e.g. Garage, Shelf 2, Bin A" />
        <MudSelect T="int?" @bind-Value="_newParentId" Label="Parent (optional)">
            <MudSelectItem T="int?" Value="null">— Top level —</MudSelectItem>
            @foreach (var location in _locations)
            {
                <MudSelectItem T="int?" Value="location.Id">@location.Name</MudSelectItem>
            }
        </MudSelect>
        <MudTextField @bind-Value="_newNotes" Label="Notes (optional)" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Add" Disabled="@string.IsNullOrWhiteSpace(_newName)">
            Add
        </MudButton>
    </MudStack>
</MudPaper>

<MudPaper Class="pa-4" Outlined="true">
    @if (_locations.Count == 0)
    {
        <MudText Typo="Typo.body2">No storage locations yet.</MudText>
    }
    else
    {
        @foreach (var root in _locations.Where(l => l.ParentLocationId is null).OrderBy(l => l.Name))
        {
            <StorageLocationNode Location="root" AllLocations="_locations" OnDelete="Delete" />
        }
    }
</MudPaper>

@code {
    private List<StorageLocation> _locations = [];
    private string _newName = "";
    private int? _newParentId;
    private string _newNotes = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _locations = await Db.StorageLocations.ToListAsync();
    }

    private async Task Add()
    {
        Db.StorageLocations.Add(new StorageLocation
        {
            Name = _newName.Trim(),
            ParentLocationId = _newParentId,
            Notes = string.IsNullOrWhiteSpace(_newNotes) ? null : _newNotes.Trim()
        });
        await Db.SaveChangesAsync();

        _newName = "";
        _newParentId = null;
        _newNotes = "";
        await LoadAsync();
    }

    private async Task Delete(StorageLocation location)
    {
        Db.StorageLocations.Remove(location);
        await Db.SaveChangesAsync();
        await LoadAsync();
    }
}
